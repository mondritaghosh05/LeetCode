class Solution {
public:
    string longestPalindrome(string s) {
        string result = "";
        int subs_len = 0;
        for (int i = 0; i < s.length(); i++) {
            int l1 = i;
            int r1 = i+1;
            while (r1 < s.size() && l1 >= 0 && s[l1] == s[r1]) {
                if ((r1 - l1 + 1) > subs_len) {
                    result = s.substr(l1, r1 - l1 + 1);
                    subs_len = r1 - l1 + 1;
                }
                l1--;
                r1++;
            }
            int l2 = i;
            int r2 = i;
            while (l2 >= 0 && r2 < s.size() && s[l2] == s[r2]) {
                if ((r2 - l2 + 1) > subs_len) {
                    result = s.substr(l2, r2 - l2 + 1);
                    subs_len = r2 - l2 + 1;
                }
                l2--;
                r2++;
            }
        }
        return result;
    }  
};
