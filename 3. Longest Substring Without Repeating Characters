#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_map <char, int> freq;
        int left = 0;
        int right = 0;
        int max_length = 0;
        while (right < s.length()) {
            freq[s[right]]++;
            while (freq[s[right]] > 1) {
                freq[s[left]]--;
                left++;             
            }
            right++;
            max_length = max(max_length, right - left);
        }
        return max_length;
    }
};
